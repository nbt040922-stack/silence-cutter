<UserControl x:Class="ContentOps.Monitor.Views.JobsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="JobFilterBox" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#101B2D"/><Setter Property="BorderBrush" Value="#263B55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,9,0" Foreground="{StaticResource MutedBrush}"/>
                    <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#142237" BorderBrush="#304863" BorderThickness="1" CornerRadius="5" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="3"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="JobFilterItem" TargetType="ComboBoxItem"><Setter Property="Padding" Value="9,6"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#1B3B5B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#1E4F76"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="JobSmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="25"/><Setter Property="Height" Value="25"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="10"/></Style>
        <Style x:Key="JobPageButton" TargetType="Button" BasedOn="{StaticResource JobSmallButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#3D9FEB"/><Setter Property="BorderBrush" Value="#69C3FF"/><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="JobDetailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="HideWhenRunning" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsStatusView}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>

    <Grid MinHeight="650">
        <Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,11">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Trạng thái" Style="{StaticResource MutedText}" FontSize="9" Margin="0,0,0,4"/><ComboBox Style="{StaticResource JobFilterBox}" ItemContainerStyle="{StaticResource JobFilterItem}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Loại job" Style="{StaticResource MutedText}" FontSize="9" Margin="0,0,0,4"/><ComboBox Style="{StaticResource JobFilterBox}" ItemContainerStyle="{StaticResource JobFilterItem}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter, Mode=TwoWay}"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Kênh" Style="{StaticResource MutedText}" FontSize="9" Margin="0,0,0,4"/><ComboBox Style="{StaticResource JobFilterBox}" ItemContainerStyle="{StaticResource JobFilterItem}" ItemsSource="{Binding ChannelOptions}" SelectedIndex="0"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Ngày tạo" Style="{StaticResource MutedText}" FontSize="9" Margin="0,0,0,4"/><Border Height="32" Background="#101B2D" BorderBrush="#263B55" BorderThickness="1" CornerRadius="5"><Grid><TextBlock Text="Từ ngày          → Đến ngày" Style="{StaticResource MutedText}" FontSize="9" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="&#xE787;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,9,0"/></Grid></Border></StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="Tìm kiếm" Style="{StaticResource MutedText}" FontSize="9" Margin="0,0,0,4"/><Grid><TextBox Height="32" Padding="9,0,29,0" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="10"/><TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,9,0"/></Grid></StackPanel>
                    <Button Grid.Column="5" Command="{Binding DataContext.ClearHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" Height="32" Margin="0,17,0,0" Padding="12,0" Background="#552738" BorderBrush="#A83A55">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource JobDetailButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAllJobsView}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"/><TextBlock Text="Xóa lịch sử" FontSize="10" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsStatusView}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="7" Background="#173C68"><TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="12" Foreground="#55AFFF"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Tất cả" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding TotalCount}" FontSize="14" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="1" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="7" Background="#143D35"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" Foreground="#37D397"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Đang chạy" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding RunningCount}" FontSize="14" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="2" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="7" Background="#4A3715"><TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="12" Foreground="#FFB52E"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Chờ xử lý" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding QueuedCount}" FontSize="14" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="3" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="7" Background="#39275E"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="12" Foreground="#B994FF"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Hoàn thành" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding CompletedCount}" FontSize="14" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="4" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="25" Height="25" CornerRadius="7" Background="#51222D"><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="12" Foreground="#FF6278"/></Border><StackPanel Margin="8,0,0,0"><TextBlock Text="Thất bại" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding FailedCount}" FontSize="14" FontWeight="SemiBold"/></StackPanel></StackPanel></Border>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="Hiển thị" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><Border Background="#101B2D" BorderBrush="#263B55" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="7,0,0,0"><TextBlock Text="10  ⌄" FontSize="9"/></Border></StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding IsStatusView, Converter={StaticResource BoolVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="7" Background="{Binding MetricOneBackground}"><TextBlock Text="{Binding MetricOneGlyph}" Style="{StaticResource IconText}" FontSize="15" Foreground="{Binding MetricOneForeground}"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding MetricOneTitle}" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding MetricOneValue}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding MetricOneCaption}" Style="{StaticResource MutedText}" FontSize="7.5"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="1" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="7" Background="#173C68"><TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="15" Foreground="#55AFFF"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding MetricTwoTitle}" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding MetricTwoValue}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding MetricTwoCaption}" Style="{StaticResource MutedText}" FontSize="7.5"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="2" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="7" Background="#4A3715"><TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="15" Foreground="#FFB52E"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding MetricThreeTitle}" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding MetricThreeValue}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding MetricThreeCaption}" Style="{StaticResource MutedText}" FontSize="7.5"/></StackPanel></StackPanel></Border>
                    <Border Grid.Column="3" Background="#101E31" CornerRadius="7" Padding="10,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="7" Background="#39275E"><TextBlock Text="&#xE916;" Style="{StaticResource IconText}" FontSize="15" Foreground="#B994FF"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding MetricFourTitle}" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Text="{Binding MetricFourValue}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding MetricFourCaption}" Style="{StaticResource MutedText}" FontSize="7.5"/></StackPanel></StackPanel></Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="Hiển thị" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><Border Background="#101B2D" BorderBrush="#263B55" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="7,0,0,0"><TextBlock Text="10  ⌄" FontSize="9"/></Border></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsStatusView}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3.7*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,4,0" Padding="10" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                    <Grid Background="#122034">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.55*"/><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Job" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" Margin="12,0"/><TextBlock Grid.Column="1" Text="Kênh" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Loại" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Pipeline" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="Tiến độ" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="Trạng thái" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="Tạo lúc" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="7" Text="Thao tác" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleRows}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.SelectJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <Border x:Name="RowBorder" Height="58" Background="#122034" BorderThickness="0" Padding="10,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.55*"/><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.75*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="42" Height="36" CornerRadius="5" Background="{Binding ThumbnailBrush}"><TextBlock Text="{Binding ThumbnailGlyph}" Style="{StaticResource IconText}" FontSize="17" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0"><TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="28"/><TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" FontSize="7.5" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="8.5" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="{Binding TypeBackground}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Type}" Foreground="{Binding TypeForeground}" FontSize="7.5" FontWeight="SemiBold"/></Border>
                                        <TextBlock Grid.Column="3" Text="{Binding PipelineText}" Foreground="{Binding PipelineColor}" FontSize="7.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding ProgressText}" FontSize="8"/><ProgressBar Height="4" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="#318CF3" Background="#213951" BorderThickness="0"/></StackPanel>
                                        <Border Grid.Column="5" Background="{Binding StatusBackground}" CornerRadius="4" Padding="5,3" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="7" FontWeight="SemiBold"/></Border>
                                        <StackPanel Grid.Column="6" VerticalAlignment="Center"><TextBlock Text="{Binding CreatedTimeText}" FontSize="8"/><TextBlock Text="{Binding CreatedDateText}" Style="{StaticResource MutedText}" FontSize="7.5"/></StackPanel>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding DataContext.JobPrimaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobSmallButton}" ToolTip="Thao tác chính"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="10"/></Button><Button Command="{Binding DataContext.JobSecondaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobSmallButton}" ToolTip="Thao tác phụ"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" FontSize="10"/></Button><TextBlock Text="&#xE712;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,0"/></StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#17314B"/></DataTrigger></DataTemplate.Triggers>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Grid.Row="2" Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource JobSmallButton}" Content="‹" Command="{Binding PagingCommand}" CommandParameter="prev"/><ItemsControl ItemsSource="{Binding PageItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource JobPageButton}" Content="{Binding Number}" Command="{Binding DataContext.PagingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Style="{StaticResource JobSmallButton}" Content="›" Command="{Binding PagingCommand}" CommandParameter="next"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding RangeText}" Style="{StaticResource MutedText}" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="14">
                <Grid DataContext="{Binding SelectedJob}">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Chi tiết Job" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></Grid>
                    <Grid Grid.Row="1" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="56" Height="48" CornerRadius="6" Background="{Binding ThumbnailBrush}"><TextBlock Text="{Binding ThumbnailGlyph}" Style="{StaticResource IconText}" FontSize="21" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="31"/><Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="{Binding Type}" Foreground="{Binding TypeForeground}" FontSize="7.5"/></Border></StackPanel></Grid>
                    <StackPanel Grid.Row="2" Margin="0,8"><TextBlock Text="Thông tin chung" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Kênh" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="8"/><TextBlock Grid.Row="1" Text="Loại job" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Type}" FontSize="8"/><TextBlock Grid.Row="2" Text="Trạng thái" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="8"/><TextBlock Grid.Row="3" Text="Tạo lúc" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedDateText}" FontSize="8"/><TextBlock Grid.Row="4" Text="Cập nhật" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UpdatedText}" FontSize="8" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="5" Text="Job ID" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Id}" FontSize="7.5" TextTrimming="CharacterEllipsis"/></Grid></StackPanel>
                    <Border Grid.Row="3" Background="#263B55"/>
                    <StackPanel Grid.Row="4" Margin="0,10"><TextBlock Text="Pipeline chi tiết" FontSize="9.5" FontWeight="SemiBold"/><TextBlock Text="{Binding PipelineText}" Foreground="{Binding PipelineColor}" FontSize="8.5" TextWrapping="Wrap" Margin="0,10,0,0"/><ProgressBar Height="5" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="#318CF3" Background="#213951" BorderThickness="0" Margin="0,10,0,0"/><TextBlock Text="{Binding ErrorText}" Style="{StaticResource MutedText}" FontSize="8" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="{Binding MetadataText}" Style="{StaticResource MutedText}" FontSize="7.5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel Grid.Row="5"><TextBlock Text="Thao tác" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,6"/><UniformGrid Columns="2" Rows="2"><Button Command="{Binding DataContext.JobPrimaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30" Margin="0,0,5,5" Background="#246DE5"><TextBlock Text="{Binding PrimaryActionText}" FontSize="8"/></Button><Button Command="{Binding DataContext.JobSecondaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30" Margin="0,0,0,5"><TextBlock Text="{Binding SecondaryActionText}" FontSize="8"/></Button><Button Command="{Binding DataContext.JobOpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30" Margin="0,0,5,0"><TextBlock Text="Mở thư mục output" FontSize="8"/></Button><Button Command="{Binding DataContext.JobCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30"><TextBlock Text="✕  Hủy Job" Foreground="{StaticResource RedBrush}" FontSize="8"/></Button></UniformGrid></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Visibility="{Binding IsStatusView, Converter={StaticResource BoolVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3.7*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,4,0" Padding="10" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                    <Grid Background="#122034">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="0.78*"/><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Job" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" Margin="12,0"/><TextBlock Grid.Column="1" Text="Kênh" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Pipeline" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Tiến độ" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding DurationColumnTitle}" Style="{StaticResource MutedText}" FontSize="8.5" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding EstimateColumnTitle}" Style="{StaticResource MutedText}" FontSize="8.5" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="Thao tác" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleRows}" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Command="{Binding DataContext.SelectJobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch">
                                <Border Height="76" Background="#122034" Padding="10,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="0.78*"/><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="0.92*"/><ColumnDefinition Width="0.72*"/></Grid.ColumnDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="42" CornerRadius="5" Background="{Binding ThumbnailBrush}"><Grid><TextBlock Text="{Binding ThumbnailGlyph}" Style="{StaticResource IconText}" FontSize="19" Foreground="{StaticResource AccentBrush}"/><Border Background="#174568" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"><TextBlock Text="AUTO" FontSize="6.5" Foreground="#68C4FF"/></Border></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,5,0"><TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="30"/><TextBlock Text="{Binding Channel}" Style="{StaticResource MutedText}" FontSize="7.5" Margin="0,2,0,0"/></StackPanel></Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="8.5" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding PipelineText}" Foreground="#35D599" FontSize="7.5" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="Notify" Style="{StaticResource MutedText}" FontSize="6.5"/><TextBlock Text="     Download" Style="{StaticResource MutedText}" FontSize="6.5"/><TextBlock Text="     Silence" Style="{StaticResource MutedText}" FontSize="6.5"/><TextBlock Text="     Output" Style="{StaticResource MutedText}" FontSize="6.5"/></StackPanel></StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding ProgressText}" FontSize="8.5"/><ProgressBar Height="5" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="#318CF3" Background="#213951" BorderThickness="0" Margin="0,4,0,0"/></StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding ElapsedText}" FontSize="8" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center"><TextBlock Text="{Binding EstimatedCompletionTimeText}" FontSize="8"/><TextBlock Text="{Binding EstimatedCompletionDateText}" Style="{StaticResource MutedText}" FontSize="7.5"/></StackPanel>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding DataContext.JobPrimaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobSmallButton}" ToolTip="Thao tác chính"><TextBlock Text="{Binding PrimaryActionGlyph}" FontSize="10"/></Button><Button Command="{Binding DataContext.JobSecondaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobSmallButton}" ToolTip="Thao tác phụ"><TextBlock Text="{Binding SecondaryActionGlyph}" FontSize="8"/></Button><TextBlock Text="&#xE712;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,0" VerticalAlignment="Center"/></StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource JobSmallButton}" Content="‹" Command="{Binding PagingCommand}" CommandParameter="prev"/><ItemsControl ItemsSource="{Binding PageItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource JobPageButton}" Content="{Binding Number}" Command="{Binding DataContext.PagingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Number}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Style="{StaticResource JobSmallButton}" Content="›" Command="{Binding PagingCommand}" CommandParameter="next"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding RangeText}" Style="{StaticResource MutedText}" FontSize="8.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="14">
                <Grid DataContext="{Binding SelectedJob}">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Chi tiết Job" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></Grid>
                    <Grid Grid.Row="1" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="64" Height="52" CornerRadius="6" Background="{Binding ThumbnailBrush}"><TextBlock Text="{Binding ThumbnailGlyph}" Style="{StaticResource IconText}" FontSize="22" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="31"/><Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" Margin="0,4,0,0"><TextBlock Text="{Binding Type}" Foreground="{Binding TypeForeground}" FontSize="7.5"/></Border><TextBlock Text="{Binding Id, StringFormat=Job ID: {0}}" Style="{StaticResource MutedText}" FontSize="7" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                    <StackPanel Grid.Row="2" Margin="0,8"><TextBlock Text="Thông tin chung" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Kênh" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="1" Text="{Binding Channel}" FontSize="8"/><TextBlock Grid.Row="1" Text="Loại job" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Type}" FontSize="8"/><TextBlock Grid.Row="2" Text="Trạng thái" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="8"/><TextBlock Grid.Row="3" Text="Tạo lúc" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedDateText}" FontSize="8"/><TextBlock Grid.Row="4" Text="Bắt đầu" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedTimeText}" FontSize="8"/><TextBlock Grid.Row="5" Text="{Binding DataContext.DurationColumnTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ElapsedText}" FontSize="8"/><TextBlock Grid.Row="6" Text="{Binding DataContext.EstimateColumnTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MutedText}" FontSize="8"/><StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding EstimatedCompletionTimeText}" FontSize="8"/><TextBlock Text="  "/><TextBlock Text="{Binding EstimatedCompletionDateText}" FontSize="8"/></StackPanel></Grid></StackPanel>
                    <Border Grid.Row="3" Background="#263B55"/>
                    <StackPanel Grid.Row="4" Margin="0,10"><TextBlock Text="Pipeline chi tiết" FontSize="9.5" FontWeight="SemiBold"/><TextBlock Text="{Binding PipelineText}" Foreground="{Binding PipelineColor}" FontSize="8.5" TextWrapping="Wrap" Margin="2,12,0,0"/><ProgressBar Height="5" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="#318CF3" Background="#213951" BorderThickness="0" Margin="0,10,0,0"/><TextBlock Text="{Binding ErrorText}" Foreground="{Binding StatusForeground}" FontSize="8" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="{Binding MetadataText}" Style="{StaticResource MutedText}" FontSize="7.5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    <StackPanel Grid.Row="5"><TextBlock Text="Thao tác" FontSize="9.5" FontWeight="SemiBold" Margin="0,0,0,6"/><UniformGrid Columns="2" Rows="2"><Button Command="{Binding DataContext.JobPrimaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30" Margin="0,0,5,5" Background="#246DE5"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PrimaryActionGlyph}" FontSize="8" Margin="0,0,5,0"/><TextBlock Text="{Binding PrimaryActionText}" FontSize="8"/></StackPanel></Button><Button Command="{Binding DataContext.JobSecondaryActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SecondaryActionGlyph}" FontSize="8" Margin="0,0,5,0"/><TextBlock Text="{Binding SecondaryActionText}" FontSize="8"/></StackPanel></Button><Button Command="{Binding DataContext.JobOpenOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30" Margin="0,0,5,0"><TextBlock Text="▱  Mở thư mục đầu ra" FontSize="8"/></Button><Button Command="{Binding DataContext.JobCancelCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource JobDetailButton}" Height="30"><TextBlock Text="⌫  Xóa lịch sử" Foreground="{StaticResource RedBrush}" FontSize="8"/></Button></UniformGrid></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
