                                <CheckBox Style="{StaticResource ChannelCheckBox}" Margin="15,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="True" IsChecked="{Binding ChannelsPage.AreAllVisibleSelected, Mode=TwoWay}" Visibility="{Binding ChannelsPage.IsMultiSelect, Converter={StaticResource BoolVisibility}}"/>
                                <TextBlock Grid.Column="1" Text="Kênh" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
