<Window x:Class="ContentOps.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ContentOps.Monitor.Views"
        Title="ContentOps Monitor" Height="900" Width="1480" MinHeight="700" MinWidth="1120" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource PageBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="16,22">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="{Binding NavigationItems[9]}">
                    <StackPanel><TextBlock Text="SYSTEM HEALTH" Style="{StaticResource MutedText}" FontSize="10"/><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="8" Height="8" Fill="{Binding HealthState, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding HealthSummary}" FontSize="12"/></StackPanel><TextBlock Text="{Binding OverallStatus}" Style="{StaticResource MutedText}" FontSize="10" Margin="16,2,0,0"/><TextBlock Text="v0.1.0 · Phase 1" Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0"/></StackPanel>
                </Button>
                <StackPanel><StackPanel Orientation="Horizontal" Margin="4,0,0,28"><Border Width="30" Height="30" CornerRadius="8" Background="#1C4C73"><TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}" FontSize="17"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="CONTENTOPS" FontWeight="Bold" FontSize="15"/><TextBlock Text="MONITOR" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/></StackPanel></StackPanel><TextBlock Text="CONTROL CENTER" Style="{StaticResource MutedText}" FontSize="10" Margin="4,0,0,8"/><ItemsControl ItemsSource="{Binding NavigationItems}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource NavButton}" Visibility="{Binding IsVisible, Converter={StaticResource BoolVisibility}}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Width="30"/><TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="13"/><TextBlock Grid.Column="2" Text="{Binding ChevronGlyph}" Visibility="{Binding IsGroup, Converter={StaticResource BoolVisibility}}" Style="{StaticResource IconText}" FontSize="12"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24,22,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.Resources><Style x:Key="RoundHeaderButton" TargetType="Button"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{StaticResource CardRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Circle" Width="32" Height="32" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="#1B3B5B"/><Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Grid.Resources>
                <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding LastUpdated}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Command="{Binding RefreshCommand}" Padding="9,6" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Làm mới" FontSize="10"/></StackPanel></Button></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Command="{Binding NavigateCommand}" CommandParameter="{Binding NavigationItems[12]}" ToolTip="Mở cấu hình" Style="{StaticResource RoundHeaderButton}"><TextBlock Text="&#xE708;" Style="{StaticResource IconText}" FontSize="14"/></Button><Button Command="{Binding NavigateCommand}" CommandParameter="{Binding NavigationItems[10]}" ToolTip="Mở cảnh báo" Style="{StaticResource RoundHeaderButton}"><TextBlock Text="&#xEA8F;" Style="{StaticResource IconText}" FontSize="14"/></Button><Border Height="32" Background="{StaticResource CardRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="10,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="8" Height="8" Fill="{StaticResource GreenBrush}" Effect="{StaticResource GreenGlow}" Margin="0,0,7,0"/><TextBlock Text="SYSTEM" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="⌄" Style="{StaticResource MutedText}" FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Border></StackPanel>
            </Grid>
            <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
                <Grid MinHeight="{Binding ActualHeight, ElementName=DashboardScroll}" Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Dashboard}"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="296"/><RowDefinition Height="*" MinHeight="320"/><RowDefinition Height="24"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource MetricCard}" Background="#0D1C2C" BorderBrush="#20354D" Padding="12,8" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" VerticalAlignment="Center" CornerRadius="11" Background="#246DE5" Effect="{StaticResource BlueGlow}"><TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="White" FontSize="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Tổng Jobs hôm nay" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding TotalJobsToday}" FontSize="24" FontWeight="SemiBold" Foreground="White"/><StackPanel Orientation="Horizontal"><TextBlock Text="↑" Foreground="{StaticResource GreenBrush}" FontSize="9"/><TextBlock Text=" -- so với hôm qua" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel></StackPanel></Grid></Border>
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}" Background="#0D1C2C" BorderBrush="#20354D" Padding="12,8" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" VerticalAlignment="Center" CornerRadius="11" Background="#18A86D" Effect="{StaticResource GreenGlow}"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" Foreground="White" FontSize="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Đang chạy" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding RunningJobs}" FontSize="24" FontWeight="SemiBold" Foreground="White"/><StackPanel Orientation="Horizontal"><Ellipse Width="4" Height="4" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="hiện tại" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel></StackPanel></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}" Background="#0D1C2C" BorderBrush="#20354D" Padding="12,8" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" VerticalAlignment="Center" CornerRadius="11" Background="#F28A00" Effect="{StaticResource AmberGlow}"><TextBlock Text="&#xE823;" Style="{StaticResource IconText}" Foreground="White" FontSize="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Chờ xử lý" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding QueuedJobs}" FontSize="24" FontWeight="SemiBold" Foreground="White"/><StackPanel Orientation="Horizontal"><Ellipse Width="4" Height="4" Fill="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="trong hàng đợi" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel></StackPanel></Grid></Border>
                        <Border Grid.Column="3" Style="{StaticResource MetricCard}" Background="#0D1C2C" BorderBrush="#20354D" Padding="12,8" Margin="0,0,8,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" VerticalAlignment="Center" CornerRadius="11" Background="#7B35C8" Effect="{StaticResource PurpleGlow}"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" Foreground="White" FontSize="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Hoàn thành" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding CompletedJobs}" FontSize="24" FontWeight="SemiBold" Foreground="White"/><StackPanel Orientation="Horizontal"><TextBlock Text="↑" Foreground="{StaticResource GreenBrush}" FontSize="9"/><TextBlock Text=" -- so với hôm qua" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel></StackPanel></Grid></Border>
                        <Border Grid.Column="4" Style="{StaticResource MetricCard}" Background="#0D1C2C" BorderBrush="#20354D" Padding="12,8" Margin="0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="46" VerticalAlignment="Center" CornerRadius="11" Background="#EE334B" Effect="{StaticResource RedGlow}"><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" Foreground="White" FontSize="24"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="Thất bại" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding FailedJobs}" FontSize="24" FontWeight="SemiBold" Foreground="White"/><StackPanel Orientation="Horizontal"><TextBlock Text="↓" Foreground="{StaticResource RedBrush}" FontSize="9"/><TextBlock Text=" -- so với hôm qua" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel></StackPanel></Grid></Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,12">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="Trạng thái Services" FontSize="14" FontWeight="SemiBold"/>
                                    <Button DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="{Binding NavigationItems[9]}" Content="Xem chi tiết" Padding="7,3" Margin="0" FontSize="9"/>
                                </DockPanel>
                                <Grid DockPanel.Dock="Top" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Service" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="2" Text="Port" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="3" Text="Status" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="4" Text="PID" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="5" Text="CPU" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="6" Text="RAM" Style="{StaticResource MutedText}" FontSize="8"/><TextBlock Grid.Column="8" Text="Uptime" Style="{StaticResource MutedText}" FontSize="8"/>
                                </Grid>
                                <ItemsControl DockPanel.Dock="Top" Height="220" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ItemsSource="{Binding DashboardServices}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="5" HorizontalAlignment="Stretch"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InnerBrush}" BorderBrush="#1D3852" BorderThickness="1" CornerRadius="7" VerticalAlignment="Stretch" Padding="6,4" Margin="0,2" Effect="{StaticResource ServiceRowGlow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="24" Height="24" CornerRadius="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#153554"/>
                                                                <Setter Property="Effect" Value="{StaticResource BlueGlow}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Name}" Value="YTDOWNLOAD"><Setter Property="Background" Value="#153E62"/><Setter Property="Effect" Value="{StaticResource BlueGlow}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Silence Scheduler"><Setter Property="Background" Value="#33205C"/><Setter Property="Effect" Value="{StaticResource PurpleGlow}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Qwen"><Setter Property="Background" Value="#33205C"/><Setter Property="Effect" Value="{StaticResource PurpleGlow}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Name}" Value="Manual LAN API"><Setter Property="Background" Value="#124D3A"/><Setter Property="Effect" Value="{StaticResource GreenGlow}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding DashboardName}" FontWeight="SemiBold" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Port}" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" Background="{Binding State, Converter={StaticResource StateBrush}}" CornerRadius="10" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Effect" Value="{StaticResource GreenGlow}"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding State}" Value="DOWN"><Setter Property="Effect" Value="{StaticResource RedGlow}"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StateText}" Foreground="White" FontSize="8" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="4" Text="{Binding ProcessId, TargetNullValue=-}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding CpuText}" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding MemoryText}" FontSize="9" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center"><Button Command="{Binding DataContext.ServiceToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding ControlGlyph}" ToolTip="{Binding ControlTooltip}" FontFamily="Segoe Fluent Icons" Padding="4,2" Margin="0,0,3,0" Width="24" Height="22" Effect="{StaticResource BlueGlow}"/><Button Command="{Binding DataContext.ServiceRestartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xE72C;" ToolTip="Khởi động lại service" FontFamily="Segoe Fluent Icons" Padding="4,2" Margin="0,0,3,0" Width="24" Height="22" Effect="{StaticResource BlueGlow}"/><Button Command="{Binding DataContext.ServiceHealthCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Name}" Content="&#xE8A7;" ToolTip="Mở health endpoint" FontFamily="Segoe Fluent Icons" Padding="4,2" Margin="0" Width="24" Height="22" Effect="{StaticResource BlueGlow}"/></StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Đang chờ dữ liệu service..." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Visibility="{Binding DashboardServices, Converter={StaticResource EmptyCollectionVisibility}}"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0"><StackPanel Orientation="Horizontal"><TextBlock Text="Tổng quan Jobs" FontSize="14" FontWeight="SemiBold"/><TextBlock Text=" (7 ngày qua)" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/></StackPanel><Border Grid.Column="1" Background="{StaticResource InnerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" HorizontalAlignment="Right"><TextBlock Text="7 ngày qua ⌄" Style="{StaticResource MutedText}" FontSize="9"/></Border></Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,4"><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Rectangle Width="12" Height="2" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Hoàn thành" FontSize="9"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Rectangle Width="12" Height="2" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Đang chạy" FontSize="9"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Rectangle Width="12" Height="2" Fill="{StaticResource RedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Thất bại" FontSize="9"/></StackPanel><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="2" Fill="{StaticResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Chờ xử lý" FontSize="9"/></StackPanel></StackPanel>
                                <Grid Grid.Row="2" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,0,22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="100" Style="{StaticResource MutedText}" FontSize="8" VerticalAlignment="Top"/><TextBlock Grid.Row="1" Text="80" Style="{StaticResource MutedText}" FontSize="8" VerticalAlignment="Top"/><TextBlock Grid.Row="2" Text="60" Style="{StaticResource MutedText}" FontSize="8" VerticalAlignment="Top"/><TextBlock Grid.Row="3" Text="40" Style="{StaticResource MutedText}" FontSize="8" VerticalAlignment="Top"/><TextBlock Grid.Row="4" Text="20" Style="{StaticResource MutedText}" FontSize="8" VerticalAlignment="Top"/><TextBlock Grid.Row="4" Text="0" Style="{StaticResource MutedText}" FontSize="8" VerticalAlignment="Bottom"/></Grid>
                                    <Grid Grid.Column="1" Margin="0,0,0,22">
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="#20364B" BorderThickness="0,1,0,0"/><Border Grid.Row="1" BorderBrush="#20364B" BorderThickness="0,1,0,0"/><Border Grid.Row="2" BorderBrush="#20364B" BorderThickness="0,1,0,0"/><Border Grid.Row="3" BorderBrush="#20364B" BorderThickness="0,1,0,0"/><Border Grid.Row="4" BorderBrush="#20364B" BorderThickness="0,1,0,1"/>
                                        <ItemsControl Grid.RowSpan="5" ItemsSource="{Binding DashboardChartDates}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate><DataTemplate><Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Border Width="1" Background="#20364B" HorizontalAlignment="Center"/><Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-5"><Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" Opacity="0.35" Effect="{StaticResource GreenGlow}"/><Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Opacity="0.55" Effect="{StaticResource BlueGlow}"/><Ellipse Width="6" Height="6" Fill="{StaticResource RedBrush}" Opacity="0.7" Effect="{StaticResource RedGlow}"/><Ellipse Width="4" Height="4" Fill="{StaticResource YellowBrush}" Effect="{StaticResource AmberGlow}"/></Grid></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Grid.RowSpan="5" Height="4" Background="{StaticResource GreenBrush}" Opacity="0.25" VerticalAlignment="Bottom" Effect="{StaticResource GreenGlow}" IsHitTestVisible="False"/>
                                        <Border Grid.RowSpan="5" Height="3" Background="{StaticResource AccentBrush}" Opacity="0.35" VerticalAlignment="Bottom" Effect="{StaticResource BlueGlow}" IsHitTestVisible="False"/>
                                        <Border Grid.RowSpan="5" Height="2" Background="{StaticResource RedBrush}" Opacity="0.55" VerticalAlignment="Bottom" Effect="{StaticResource RedGlow}" IsHitTestVisible="False"/>
                                        <Border Grid.RowSpan="5" Height="1" Background="{StaticResource YellowBrush}" VerticalAlignment="Bottom" Effect="{StaticResource AmberGlow}" IsHitTestVisible="False"/>
                                        <ItemsControl Grid.RowSpan="5" ItemsSource="{Binding DashboardChartDates}" VerticalAlignment="Bottom" Margin="0,0,0,-20"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource MutedText}" FontSize="8" TextAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,12"><DockPanel><DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,7"><TextBlock Text="Jobs đang chạy" FontSize="15" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="Xem tất cả" Foreground="{StaticResource AccentBrush}" FontSize="10"/></DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding DashboardJobsHasPages, Converter={StaticResource BoolVisibility}}"><Button Content="‹" Command="{Binding DashboardPagingCommand}" CommandParameter="Jobs:prev" Padding="5,2" FontSize="11"/><TextBlock Text="{Binding DashboardJobsPageText}" VerticalAlignment="Center" Margin="6,0" FontSize="10"/><Button Content="›" Command="{Binding DashboardPagingCommand}" CommandParameter="Jobs:next" Padding="5,2" FontSize="11"/></StackPanel><ItemsControl ItemsSource="{Binding DashboardActiveJobs}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource InnerBrush}" CornerRadius="7" Padding="7" Margin="0,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><Border Width="22" Height="22" CornerRadius="5" Background="#1B3652"><TextBlock Text="&#xE8FD;" Style="{StaticResource IconText}" FontSize="11" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Channel}" Style="{StaticResource MutedText}" FontSize="9"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Stage}" Foreground="{StaticResource AccentBrush}" FontSize="9"/><ProgressBar Height="4" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#243950" BorderThickness="0"/></StackPanel><Border Grid.Column="3" Background="#1D3C5A" CornerRadius="9" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding Origin}" Foreground="{StaticResource AccentBrush}" FontSize="8"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DashboardActiveJobs, Converter={StaticResource EmptyCollectionVisibility}}"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="25" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Không có job đang chạy" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></DockPanel></Border>
