                                <TextBlock Grid.Column="5" Text="Thông báo" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="6" Text="Cắt tool" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="7" Text="Ghi chú" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="14,0">
                                <ItemsControl ItemsSource="{Binding ChannelsPage.VisibleRows}" HorizontalContentAlignment="Stretch">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" Rows="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Border x:Name="ChannelRow" Background="#101B2D" BorderBrush="#20334A" BorderThickness="0,0,0,1" Padding="0,3">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#101B2D"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#162A42"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#18334F"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource ChannelCheckBox}" Margin="15,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding DataContext.ChannelsPage.IsMultiSelect, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
                                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#173A58" BorderBrush="#285C82" BorderThickness="1"><TextBlock Text="&#xE716;" Style="{StaticResource IconText}" FontSize="14" Foreground="{StaticResource AccentBrush}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></Grid>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="StatusIcon" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"/><TextBlock x:Name="StatusLabel" FontSize="10"/></StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding NewVideosText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding LastEventText}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="NotificationIcon" Text="&#xEA8F;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"/><TextBlock x:Name="NotificationLabel" Text="{Binding NotificationText}" FontSize="10"/></StackPanel>
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="CutToolIcon" Text="&#xE8C6;" Style="{StaticResource IconText}" FontSize="11" Margin="0,0,6,0"/><TextBlock x:Name="CutToolLabel" Text="{Binding CutToolText}" FontSize="10"/></StackPanel>
                                                <TextBlock Grid.Column="7" Text="{Binding NoteText}" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="8" Width="28" Height="28" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" ToolTip="Tác vụ kênh"><TextBlock Text="&#xE712;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource MutedBrush}"/></Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Active"><Setter TargetName="StatusIcon" Property="Text" Value="&#xE73E;"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource GreenBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Active"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource GreenBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Paused"><Setter TargetName="StatusIcon" Property="Text" Value="&#xE769;"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource YellowBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Paused"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource YellowBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error"><Setter TargetName="StatusIcon" Property="Text" Value="&#xE711;"/><Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource RedBrush}"/><Setter TargetName="StatusLabel" Property="Text" Value="Error"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding NotificationStateKind}" Value="On"><Setter TargetName="NotificationIcon" Property="Foreground" Value="{StaticResource GreenBrush}"/><Setter TargetName="NotificationLabel" Property="Foreground" Value="{StaticResource GreenBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding NotificationStateKind}" Value="Off"><Setter TargetName="NotificationIcon" Property="Foreground" Value="{StaticResource RedBrush}"/><Setter TargetName="NotificationLabel" Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding CutToolStateKind}" Value="On"><Setter TargetName="CutToolIcon" Property="Foreground" Value="{StaticResource GreenBrush}"/><Setter TargetName="CutToolLabel" Property="Foreground" Value="{StaticResource GreenBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding CutToolStateKind}" Value="Off"><Setter TargetName="CutToolIcon" Property="Foreground" Value="{StaticResource RedBrush}"/><Setter TargetName="CutToolLabel" Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ChannelsPage.IsEmpty, Converter={StaticResource BoolVisibility}}"><TextBlock Text="&#xE716;" Style="{StaticResource IconText}" FontSize="28" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Không tìm thấy kênh" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Thử từ khóa khác hoặc làm mới dữ liệu." Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                            </Grid>

                            <Grid Grid.Row="3" Margin="16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" BorderBrush="#20334A" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="‹" Command="{Binding ChannelsPage.PagingCommand}" CommandParameter="prev" Width="28" Height="28" Padding="0" Margin="2,0"/>
                                    <ItemsControl ItemsSource="{Binding ChannelsPage.PageItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Command="{Binding DataContext.ChannelsPage.PagingCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Number}" Width="28" Height="28" Padding="0" Margin="2,0"><Button.Style><Style TargetType="Button"><Setter Property="Background" Value="{StaticResource CardRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="#08111D"/></DataTrigger><DataTrigger Binding="{Binding IsEllipsis}" Value="True"><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    <Button Content="›" Command="{Binding ChannelsPage.PagingCommand}" CommandParameter="next" Width="28" Height="28" Padding="0" Margin="2,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ChannelsPage.RangeText}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Background="#B3000812" Visibility="{Binding ChannelsPage.IsBulkModalOpen, Converter={StaticResource BoolVisibility}}">
                        <Border Width="400" Background="#142237" BorderBrush="#34506F" BorderThickness="1" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel><TextBlock Text="{Binding ChannelsPage.BulkModalTitle}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding ChannelsPage.BulkModalCount}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,18"/>
                                <Button Height="42" Command="{Binding ChannelsPage.BulkEnableCommand}" Margin="0,0,0,9"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ChannelsPage.BulkEnableGlyph}" Style="{StaticResource IconText}" Foreground="{StaticResource GreenBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding ChannelsPage.BulkEnableText}" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Height="42" Command="{Binding ChannelsPage.BulkDisableCommand}" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ChannelsPage.BulkDisableGlyph}" Style="{StaticResource IconText}" Foreground="{StaticResource RedBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding ChannelsPage.BulkDisableText}" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Content="Hủy" Command="{Binding ChannelsPage.CloseBulkControlCommand}" HorizontalAlignment="Right" Padding="18,7" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Manual}">
                    <Grid.Resources>
                        <Style x:Key="ManualButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="20,0"/><Setter Property="Margin" Value="0"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style>
                        <Style x:Key="ManualUrlBox" TargetType="TextBox">
                            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="11,0,34,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Tag" Value="https://www.youtube.com/watch?v=..."/><Setter Property="Background" Value="#101B2D"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#263B55"/><Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/><TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedBrush}" Margin="11,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="Text" Value=""/><Condition Property="IsKeyboardFocusWithin" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Watermark" Property="Visibility" Value="Visible"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0" Padding="22" VerticalAlignment="Top" MinHeight="488">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="176"/><RowDefinition Height="50"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Tạo job thủ công" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20"/>
                            <StackPanel Grid.Row="1"><TextBlock FontSize="11"><Run Text="URL YouTube"/><Run Text=" *" Foreground="{StaticResource RedBrush}"/></TextBlock><Grid Margin="0,7,0,0"><TextBox Style="{StaticResource ManualUrlBox}" Text="{Binding ManualUrl, UpdateSourceTrigger=PropertyChanged}"/><Button Width="24" Height="24" Padding="0" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Command="{Binding CancelManualJobCommand}"><TextBlock Text="&#xE711;" Style="{StaticResource IconText}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Button></Grid></StackPanel>
                            <TextBlock Grid.Row="2" Text="Dán link YouTube của video bạn muốn xử lý" Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,7,0,14"/>

                            <Border Grid.Row="3" Background="#101B2D" BorderBrush="#263B55" BorderThickness="1" CornerRadius="7" Padding="14">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Xem trước video" FontSize="10.5" FontWeight="SemiBold"/>
                                    <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="158" Height="108" CornerRadius="6" HorizontalAlignment="Left"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1C4966" Offset="0"/><GradientStop Color="#183149" Offset="0.45"/><GradientStop Color="#34543B" Offset="1"/></LinearGradientBrush></Border.Background><Grid><TextBlock Text="▲   ▲▲" Foreground="#79A4B6" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0"/><Border Width="34" Height="34" CornerRadius="17" Background="#B80A1726" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" Foreground="White" FontSize="17"/></Border><Border Background="#CC07111D" CornerRadius="3" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"><TextBlock Text="18:42" Foreground="White" FontSize="8"/></Border></Grid></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock Text="{Binding ManualPreviewTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ManualPreviewChannel}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,8,0,0"/><TextBlock Text="{Binding ManualPreviewDuration}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,5,0,0"/><TextBlock Text="{Binding ManualPreviewMessage}" Style="{StaticResource MutedText}" FontSize="8" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Background="#101B2D" BorderBrush="#263B55" BorderThickness="1" CornerRadius="7" Margin="0,14,0,0" Padding="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="20" Height="20" CornerRadius="10" BorderBrush="#2F9BFF" BorderThickness="1"><TextBlock Text="i" Foreground="#45A7FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Job sẽ được đưa vào hàng đợi và xử lý theo cấu hình mặc định của hệ thống." Style="{StaticResource MutedText}" FontSize="9.5" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Border>

                            <TextBlock Grid.Row="5" Text="{Binding ManualMessage}" Foreground="{StaticResource AccentBrush}" FontSize="9.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource ManualButton}" Width="100" Command="{Binding CancelManualJobCommand}" Background="#101B2D"><TextBlock Text="Hủy" FontSize="10"/></Button><Button Style="{StaticResource ManualButton}" Width="118" Margin="10,0,0,0" Command="{Binding SubmitManualJobCommand}" Background="#1769DE" BorderBrush="#2E82F1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Gửi Job" FontSize="10"/></StackPanel></Button></StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="0" VerticalAlignment="Top" MinHeight="356">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                            <TextBlock Text="Trạng thái hệ thống" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding DashboardServices}" Margin="20,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DashboardName}" FontSize="10" VerticalAlignment="Center"/><Border Grid.Column="1" Background="{Binding State, Converter={StaticResource StateBrush}}" CornerRadius="4" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="{Binding StateText}" Foreground="White" FontSize="8.5" FontWeight="SemiBold"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Border Grid.Row="2" BorderBrush="#263B55" BorderThickness="0,1,0,0" Margin="20,0" Padding="0,14"><StackPanel Orientation="Horizontal"><Border Width="20" Height="20" CornerRadius="10" BorderBrush="#2F9BFF" BorderThickness="1"><TextBlock Text="i" Foreground="#45A7FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding OverallStatus}" Style="{StaticResource MutedText}" FontSize="9.5" TextWrapping="Wrap" Margin="10,1,0,0" MaxWidth="180"/></StackPanel></Border>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Services}"><ItemsControl ItemsSource="{Binding Services}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><Border Width="30" Height="30" CornerRadius="15" Background="#1B3652"><TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Port, StringFormat=Port {0}}" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Border Grid.Column="2" Background="{Binding State, Converter={StaticResource StateBrush}}" CornerRadius="12" Padding="9,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding StateText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="3"><TextBlock Text="PID" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding ProcessId}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding CpuText}"/></StackPanel><StackPanel Grid.Column="5"><TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding MemoryText}"/></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="Uptime" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding UptimeText}"/><TextBlock Text="{Binding ControlStatus}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid>
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Alerts}"><Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Cảnh báo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Alerts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource InnerBrush}" CornerRadius="8" Padding="13" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Border Width="25" Height="25" CornerRadius="13" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"><TextBlock Text="&#xEA8F;" Style="{StaticResource IconText}" Foreground="White" FontSize="12"/></Border><TextBlock Grid.Column="1" Text="{Binding Component}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Timestamp}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding Resolved}" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Alerts, Converter={StaticResource EmptyCollectionVisibility}}"><TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="38" Foreground="{StaticResource GreenBrush}"/><TextBlock Text="Không có cảnh báo" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="Tất cả dịch vụ đang hoạt động bình thường." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border></Grid>
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Logs}"><Border Style="{StaticResource Card}" MinHeight="520"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="Nhật ký" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Command="{Binding RefreshCommand}" Content="Tất cả" Padding="9,5" FontSize="11"/><Button Command="{Binding RefreshCommand}" Content="Làm mới" Padding="9,5" FontSize="11"/><Button Command="{Binding OpenLogFolderCommand}" Content="Mở thư mục log" Padding="9,5" FontSize="11"/></StackPanel></DockPanel><Border Background="#0A101B" CornerRadius="8" Padding="22"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE756;" Style="{StaticResource IconText}" FontSize="40" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Chưa có đường dẫn log được cấu hình." FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Cấu hình thư mục log để xem recent lines tại đây." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></Border></DockPanel></Border></Grid>
                <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisibility}, ConverterParameter=Config}"><Border Style="{StaticResource Card}" MaxWidth="900" HorizontalAlignment="Left"><StackPanel><TextBlock Text="Cấu hình Monitor" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Thiết lập cục bộ được lưu dưới %LOCALAPPDATA%\ContentOps\Monitor\" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,22"/><TextBlock Text="Poll interval" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="5 giây" FontSize="15" Margin="0,5,0,16"/><TextBlock Text="Notifications" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Đang bật · chỉ thông báo khi service chuyển trạng thái" FontSize="15" Margin="0,5,0,16"/><TextBlock Text="Service endpoints" FontWeight="SemiBold" Margin="0,6,0,10"/><ItemsControl ItemsSource="{Binding Services}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><TextBlock Text="{Binding Name}" Width="190"/><TextBlock Text="{Binding Port}" Foreground="{StaticResource MutedBrush}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
            </Grid></ScrollViewer>
        </Grid>
    </Grid>
</Window>
