<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBrush" Color="#0A1220"/><SolidColorBrush x:Key="SidebarBrush" Color="#0E1A2B"/><SolidColorBrush x:Key="CardBrush" Color="#142237"/><SolidColorBrush x:Key="CardRaisedBrush" Color="#182A43"/><SolidColorBrush x:Key="InnerBrush" Color="#101B2D"/><SolidColorBrush x:Key="BorderBrush" Color="#263B55"/><SolidColorBrush x:Key="TextBrush" Color="#E7F0FB"/><SolidColorBrush x:Key="MutedBrush" Color="#8EA4BD"/><SolidColorBrush x:Key="AccentBrush" Color="#62B8F4"/><SolidColorBrush x:Key="GreenBrush" Color="#48D29A"/><SolidColorBrush x:Key="YellowBrush" Color="#E6B756"/><SolidColorBrush x:Key="RedBrush" Color="#F07888"/><SolidColorBrush x:Key="PurpleBrush" Color="#A98BFF"/>
    <DropShadowEffect x:Key="BlueGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="#2B7BFF"/><DropShadowEffect x:Key="GreenGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="#16D99B"/><DropShadowEffect x:Key="AmberGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="#FF9D16"/><DropShadowEffect x:Key="PurpleGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="#9C5CFF"/><DropShadowEffect x:Key="RedGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="#FF3855"/><DropShadowEffect x:Key="ServiceRowGlow" BlurRadius="9" ShadowDepth="0" Opacity="0.28" Color="#2B7BFF"/>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource PageBrush}"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style><Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></Style><Style x:Key="IconText" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="17"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource CardRaisedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,2,8,2"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2,0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="AccentBar" Background="Transparent" CornerRadius="2"/><ContentPresenter Grid.Column="1" ContentSource="Content"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#162B45"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#1B3B5B"/><Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsChild}" Value="True"><Setter Property="Margin" Value="20,1,0,1"/><Setter Property="Padding" Value="10,7"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ChildNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="20,1,0,1"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,14,14"/></Style>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000"/></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CardRaisedBrush}"/><Setter Property="BorderBrush" Value="#3A668C"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource InnerBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="10,8"/></Style><Style TargetType="PasswordBox"><Setter Property="Background" Value="{StaticResource InnerBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource InnerBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#20334A"/><Setter Property="RowBackground" Value="{StaticResource InnerBrush}"/><Setter Property="AlternatingRowBackground" Value="#132238"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="42"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1B3048"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
</ResourceDictionary>
