<Application x:Class="ContentOps.Monitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ContentOps.Monitor"
             xmlns:conv="clr-namespace:ContentOps.Monitor.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:PageVisibilityConverter x:Key="PageVisibility" />
            <conv:StateBrushConverter x:Key="StateBrush" />
            <conv:SeverityBrushConverter x:Key="SeverityBrush" />
            <conv:ActiveNavBrushConverter x:Key="ActiveNavBrush" />
            <conv:EmptyCollectionVisibilityConverter x:Key="EmptyCollectionVisibility" />
            <conv:BoolVisibilityConverter x:Key="BoolVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
